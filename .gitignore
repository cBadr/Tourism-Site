# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — كل ملفات البيئة محجوبة، عدا القالب.
# `.env.example` عقد البيئة: أسماء المتغيرات وشروحها بلا أي قيمة سرّية،
# وبدونه لا يعرف أحد ما الذي يجب ضبطه ليعمل المشروع أصلاً.
.env*
!.env.example

# نسخ قاعدة البيانات — يولّدها `pnpm db:backup`.
# تحتوي بيانات العملاء والمتعهدين والدفتر المالي كاملة، ومنها جدول auth.
# رفعها إلى git تسريبٌ دائم لا يُتراجَع عنه بحذف الملف لاحقاً.
/backups/
# ⚠ والقاعدة أعلاه وحدها لم تكن تكفي: `pnpm db:backup` بلا BACKUP_DIR يكتب
# الملف في **جذر المشروع** لا في /backups/، فيقع خارج الحماية تماماً. وأي
# `git add -A` بعده يدفن مخطط auth — تجزئات كلمات المرور وتوكنات الحجوزات —
# في التاريخ إلى الأبد. فالحماية بالنمط لا بالمجلد.
*.dump
*.dump.gz
*.sql.gz
tours-01_*.dump

# سجلّ يولّده الاستطلاع أحياناً — ليس من المصدر
/index.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# مسابر مؤقتة — سكربتات استطلاع تُكتب أثناء العمل ثم تُحذف.
# ولماذا تُكتب داخل المشروع أصلاً؟ لأن Node يحلّ الوحدات بموضع الملف، فمسبارٌ
# في مجلد مؤقت خارجي لا يجد `dotenv` ولا `pg`. فالمكان مفروض، والحجب هنا يمنع
# أن ينتهي أحدها في كمّة بالسهو — وقد تراكمت منها ستة في جلسة واحدة.
/_*
/tmp-probe/
/tmp_probe*
/scratch_probe/
/scripts/_*

# ⚠ ولا يُحجب ما يعيش داخل `app/` — الحجب هناك يخفي **مساراً حقيقياً** عن
# المراجعة. وقد تُرك في هذه الجلسة `app/api/probe-render/route.ts`: نقطةَ نهاية
# **بلا حارس** تنادي `createServiceSupabase()` — أي تتخطّى RLS كلها — وتطبع
# حمولات الإشعارات بأسماء العملاء وأرقامهم. حُذفت. والدرس: مسبارٌ داخل `app/`
# يُحذف فوراً لا يُحجب، لأن الحجب يجعله يعيش في الشجرة بلا أن يراه أحد.
