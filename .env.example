# ============================================================
# انسخ هذا الملف إلى .env.local ثم املأ القيم من لوحة Supabase
# (Project Settings ← API) — لا تضع قيماً حقيقية هنا
# ============================================================

# رابط مشروع Supabase — عام، يظهر للمتصفح
NEXT_PUBLIC_SUPABASE_URL=

# المفتاح العام (anon/publishable) — عام، محمي بسياسات RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح service_role — سرّي للخادم فقط، يتجاوز RLS بالكامل.
# لا يُكشف للمتصفح أبداً ولا يبدأ باسم NEXT_PUBLIC_ إطلاقاً.
SUPABASE_SERVICE_ROLE_KEY=

# رابط الاتصال المباشر بقاعدة البيانات — **إلزامي** لكل أدوات سطر الأوامر:
# pnpm db:migrate و pnpm db:test وسكربتات الدعوات والعروض التجريبية.
# (تطبيق الويب نفسه لا يستعمله؛ هو يمر بـ Supabase عبر المفاتيح أعلاه.)
#
# ⚠ استعمل **Session pooler** لا المضيف المباشر: العنوان المباشر
# db.<ref>.supabase.co يعمل على IPv6 فقط ويفشل على الشبكات المنزلية المصرية.
# من لوحة Supabase: زر Connect ← Session pooler ← انسخ الـ URI.
# الصيغة: postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# الرابط الكامل للموقع (بدون / في النهاية) — يُستخدم للسيو والروابط المطلقة
# محلياً: http://localhost:3000 — في الإنتاج: https://your-domain.com
SITE_URL=http://localhost:3000

# مفتاح Google Maps (اختياري) — يرقّي محرك المسافات من OSRM المجاني إلى
# Google Routes. بدونه يعمل التسعير كاملاً على المزوّد المجاني (lib/geo/route.ts).
GOOGLE_MAPS_API_KEY=

# ============================================================
# الترجمة الآلية (المرحلة ٨) — اختيارية كلها
# بدونها تعمل شاشة اللغات وتقبل الترجمة اليدوية؛ يتعطل زر «ترجم الباقي آلياً» فقط.
# ============================================================

# مزوّد الترجمة: mymemory (مجاني بلا مفتاح) | deepl | google
MT_PROVIDER=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
# بريدك — يرفع حصة MyMemory المجانية اليومية
MYMEMORY_EMAIL=

# ============================================================
# بوابات الدفع (المرحلة ٩) — راجع /admin/payments لقائمة تحقق لكل بوابة
# ============================================================

# ⚠ حارس بوابة الاختبار. بوابة `test` أداة تحقق لا وسيلة تحصيل: تفعيلها من
# اللوحة **وحده** لا يكفي، بل يلزم هذا المتغيّر = 1. لا تضبطه في الإنتاج أبداً —
# وجوده هناك يعني زر «أكّد حجزي مجاناً» على موقعك.
ALLOW_TEST_PAYMENTS=

# مفاتيح المزوّدين الحقيقيين — كل مجموعة تُملأ عند تفعيل بوابتها فقط.
# الأسماء الدقيقة وما تحتاجه كل بوابة من أوراق: شاشة /admin/payments.
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
TWOCHECKOUT_MERCHANT_CODE=
TWOCHECKOUT_BUY_LINK_SECRET=
TWOCHECKOUT_IPN_SECRET=
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ============================================================
# الربط الخارجي والقياس (المرحلة ١٠)
# ============================================================
#
# ⚠ **المعرّفات لا تُوضع هنا.** معرّفات GA4 وGTM وSearch Console وبكسل ميتا
# وكلاريتي وبينج كلها تُدار من اللوحة: /admin/integrations ← وتُخزَّن في
# site_settings. السبب أن نسخة الـ whitelabel الثانية لها معرّفاتها هي، ولو
# عاشت في البيئة لصار كل إطلاق علامة جديدة نشراً جديداً.
# (المتغيّر القديم NEXT_PUBLIC_GA_ID لم يعد يُقرأ من أي ملف — احذفه من بيئتك.)
#
# ما يبقى هنا هو **السرّ وحده**: توكن واجهة التحويلات من ميتا.

# توكن Meta Conversions API — سرّي، ولا يصل المتصفح إطلاقاً.
# استخراجه: business.facebook.com ← مدير الأحداث (Events Manager) ← اختر مصدر
# البيانات (البكسل) ← الإعدادات ← «Conversions API» ← إنشاء رمز وصول.
# بدونه تُتخطّى واجهة التحويلات **بصمت** ولا يتعطل شيء: الحجز يكتمل، والحدث
# يُسجَّل في جدول funnel_events كالمعتاد، وبكسل المتصفح يعمل إن كان مفعّلاً.
# ملاحظة: معرّف مجموعة البيانات ليس سرّاً ومكانه اللوحة (وهو معرّف البكسل نفسه).
META_CAPI_ACCESS_TOKEN=

# رمز أحداث الاختبار من ميتا (اختياري، وللتجربة وحدها).
# مدير الأحداث ← تبويب «Test Events» ← انسخ الرمز الظاهر (يبدأ بـ TEST).
# مع ضبطه تظهر أحداثك في تلك الشاشة فوراً بدل انتظار التقارير — وهي الطريقة
# الوحيدة للتأكد أن حدث الشراء وصل ميتا فعلاً. **احذفه قبل الإطلاق** وإلا
# استمرت الأحداث الحقيقية موسومة بأنها اختبارية فلا تُحتسب في التحسين.
META_CAPI_TEST_EVENT_CODE=

# ============================================================
# اللغات (المرحلة ٨) — الدليل الكامل: docs/LANGUAGES.md
# ============================================================

# رموز اللغات التي يعرف الموقع **توجيهها** — مفصولة بفاصلة، والعربية أولاً دائماً.
# مثال: ar,en,fr
#
# اقرأ هذا السطر جيداً: إضافة لغة من لوحة التحكم تسجّلها وتترجمها وتنشرها،
# لكن الرابط ‎/fr/…‎ لا يعمل حتى يُذكر رمزها هنا (وفي Environment Variables على
# Vercel ثم إعادة نشر). السبب أن قرار التوجيه يقع في الوسيط على كل طلب قبل أي
# تصيير، وربطه بقاعدة البيانات يعني نداء شبكة لكل صفحة وكل ملف.
#
# الرمز يجب أن يكون معروفاً في فهرس `LOCALE_CATALOG` داخل i18n/config.ts
# (ar, en, fr, de, it, es, ru حالياً) — وما عداه يُتجاهل بصمت.
# اتركه فارغاً ليعمل الموقع بالمشحون مع المستودع: ar,en
NEXT_PUBLIC_SITE_LOCALES=ar,en

# ============================================================
# الإشعارات (المرحلة ٤) — الدليل الكامل خطوة بخطوة: docs/NOTIFICATIONS.md
# كل متغير هنا اختياري: بدونه يعمل جرس اللوحة وتُسجَّل القناة «متجاوَزة»
# بسبب واضح في /admin/notifications، ولا يتعطل أي شيء آخر.
# ============================================================

# توكن بوت تليجرام من BotFather — سرّي (من يملكه يتحكم بالبوت).
# استخراجه: docs/NOTIFICATIONS.md القسم ٢-١. معرّف المحادثة ليس سرّاً
# ومكانه اللوحة: الإعدادات ← الإشعارات.
TELEGRAM_BOT_TOKEN=

# مفتاح Resend لإرسال البريد (يبدأ بـ re_) — سرّي، يظهر مرة واحدة عند إنشائه.
# التسجيل وإنشاء المفتاح: docs/NOTIFICATIONS.md القسم ٣.
RESEND_API_KEY=

# عنوان مُرسِل البريد — اتركه فارغاً ليُستخدم العنوان التجريبي onboarding@resend.dev
# (يصل إلى بريد حسابك أنت فقط). للإنتاج وثّق نطاقك أولاً: docs/NOTIFICATIONS.md القسم ٣.
NOTIFY_EMAIL_FROM=

# كلمة سر تحمي مسار عامل الإرسال /api/notifications/dispatch من الإنترنت.
# اخترعها أنت — أي نص عشوائي طويل. مثال للتوليد:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# التفاصيل: docs/NOTIFICATIONS.md القسم ٤.
NOTIFY_DISPATCH_KEY=

# للنشر على Vercel فقط: قيمة عشوائية تضبطها في Environment Variables،
# وترسلها Vercel تلقائياً في ترويسة Authorization مع كل تشغيل مجدول
# (الجدولة معرَّفة في vercel.json). التفاصيل: docs/NOTIFICATIONS.md القسم ٥.
CRON_SECRET=
